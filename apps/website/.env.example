# ---- Supabase (form storage) ----
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Recommended — server-only key used by the API routes to write leads/subscribers.
# It bypasses RLS (correct for trusted server code) and avoids "row violates
# row-level security policy" errors. Find it in Supabase → Project Settings → API
# → service_role. NEVER expose this to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Resend (transactional email) ----
RESEND_API_KEY=your-resend-api-key

# Optional — where lead/newsletter notifications are sent.
# Until you verify a sending domain in Resend, set this to the email on your
# Resend account (Resend's test sender only delivers to the account owner).
LEAD_NOTIFY_EMAIL=you@example.com

# Optional — extra recipients CC'd on every notification.
# Comma-separated list, e.g. "sales@example.com, ops@example.com"
LEAD_NOTIFY_CC=

# Optional — the "from" address. Defaults to onboarding@resend.dev (works
# without domain verification). After verifying a domain, use e.g.:
# RESEND_FROM=EcomStrait <hello@yourdomain.com>
RESEND_FROM=EcomStrait <onboarding@resend.dev>

# ---- AI Gateway (EcomAI engine, via @ecomstrait/ai) ----
# Points at the self-hosted LiteLLM proxy — see Docs/AI-Native-Manual-Setup.md
# and Docs/AI-Native-Migration-Plan.md. Without these, the demos still work on
# the deterministic preset engine (the AI layer is a progressive enhancement).
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
# Role -> model alias. The alias is a name defined in the proxy's own
# litellm_config.yaml (e.g. "workhorse" -> claude-sonnet, or a self-hosted
# Ollama model) — never a vendor model id here. Swapping providers is a
# one-line change on the proxy, never here.
# REQUIRED per role actually used — no hardcoded fallback, so a missing role
# fails loudly instead of silently degrading to the wrong model.
AI_MODEL_WORKHORSE=workhorse
AI_MODEL_REASONING=reasoning
AI_MODEL_FAST_CHEAP=fast-cheap
AI_MODEL_EMBEDDINGS=embeddings

# ---- Supplier portal (separate app) ----
# Where the website "Become a Supplier" CTAs point. Set to the deployed
# supplier app URL in production, e.g. https://app.ecomstrait.com
NEXT_PUBLIC_SUPPLIER_APP_URL=http://localhost:3001

# ---- Merchant portal (separate app) ----
# Where every "Build My Business" CTA points (site.ts: merchantSignupUrl =
# `${this}/signup`). Set to the deployed merchant app URL — attaching a
# custom domain later is just updating this value, no code change needed.
NEXT_PUBLIC_MERCHANT_APP_URL=https://os-merchant.vercel.app
