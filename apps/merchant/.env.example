# ---- Supabase (auth + data) ----
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Auth ----
# Google OAuth is configured in the Supabase dashboard; set the redirect URL to
# <this app's origin>/auth/callback. No client secret is needed here.

# ---- App ----
NEXT_PUBLIC_MERCHANT_URL=http://localhost:3002

# ---- Custom domains (own-platform stores) ----
# Where a merchant's DNS should point — defaults already match a standard
# Vercel deployment, so these only need setting if that ever changes.
STOREFRONT_A_RECORD=
STOREFRONT_CNAME=
# Vercel API token (Account Settings -> Tokens) + the project id this app is
# deployed as. When set, a merchant's domain gets attached to the actual
# Vercel project the moment its DNS verifies — this is what makes automatic
# SSL real instead of just a claim in the Settings UI. Omit both and domain
# verification/routing still works; only the Vercel-side attachment (and
# therefore SSL) is skipped.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Only needed if the token can see more than one team/account.
VERCEL_TEAM_ID=

# ---- Stripe (added in B1) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_FULL=

# ---- AI Gateway (EcomAI, via @ecomstrait/ai) ----
# Points at the self-hosted LiteLLM proxy — see Docs/AI-Native-Manual-Setup.md
# and Docs/AI-Native-Migration-Plan.md. Without these, AI features fall back
# to the deterministic preset engine.
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
# Role -> model alias, defined in the proxy's own litellm_config.yaml — never
# a vendor model id here. REQUIRED per role actually used — no hardcoded
# fallback, so a missing role fails loudly instead of silently degrading.
AI_MODEL_WORKHORSE=workhorse
AI_MODEL_REASONING=reasoning
AI_MODEL_FAST_CHEAP=fast-cheap
AI_MODEL_EMBEDDINGS=embeddings

# ---- MCP servers (Phase 3, Docs/AI-Native-Migration-Plan.md) ----
# Connection string for a Postgres role with SELECT-only privileges, used by
# the Supabase MCP server's `query` tool. Create the role first — step 8 of
# Docs/AI-Native-Manual-Setup.md — then set this to its connection string,
# not the service-role key (which bypasses RLS and can write).
MCP_SUPABASE_READONLY_URL=

# Feature flag (Phase 4): route the post-launch editor's "question" replies
# through the new LangGraph orchestrator (RAG + tools) instead of the inline
# model reply. Off by default — flip to "true" once the orchestrator has
# been verified end to end.
AI_ADVISOR_ENABLED=

# ---- Inngest (durable jobs, added in B3) ----
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- Shopify (B5) ----
# The ecom-strait-ai app's client secret (Partner dashboard) — verifies webhook HMAC.
SHOPIFY_API_SECRET=
# Shared secret between the Shopify app and this platform (any random string).
SHOPIFY_APP_SHARED_SECRET=

# Bearer token required by /api/mcp/* (the Shopify + read-only SQL MCP servers).
# Leave unset to keep those routes switched off entirely.
MCP_SERVER_SECRET=

# 32-byte key (hex or base64) that encrypts Shopify Admin tokens at rest.
# Generate: openssl rand -hex 32. After setting it, run
# `node --env-file=.env.local scripts/reseal-shopify-tokens.mjs` once.
SHOPIFY_TOKEN_KEY=

# Optional: a secret only the supplier app knows, for the signed calls to
# /api/internal/*. Falls back to SHOPIFY_APP_SHARED_SECRET when unset.
# Must match ECOMSTRAIT_SHARED_SECRET in the supplier app.
ECOMSTRAIT_INTERNAL_SECRET=

# ---- Shopify referral ("Make it yours") ----
# Partner referral link merchants sign up through before we transfer their store.
NEXT_PUBLIC_SHOPIFY_REFERRAL_URL=https://www.shopify.com/free-trial

# ---- Ops alerts ----
# Where "store needs reconnecting" / "pool is empty" emails go. Merchants can't
# fix pool stores themselves, so these are the team's only push signal.
OPS_ALERT_EMAIL=
RESEND_API_KEY=
RESEND_FROM=EcomStrait <onboarding@resend.dev>
