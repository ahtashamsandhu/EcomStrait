# ---- Shopify (Partner dashboard → EcomStrait → App setup) ----
# Locally the Shopify CLI injects these; on Vercel you must set them by hand.
# Client ID from the Partner dashboard (App setup -> Client ID). The same value
# must go into `client_id` in shopify.app.toml, or run `shopify app config link`.
SHOPIFY_API_KEY=<your-client-id>
SHOPIFY_API_SECRET=
# Must match `scopes` in shopify.app.toml exactly, or the app requests fewer
# permissions than it declares and theme upload / inventory / publishing fail.
SCOPES=write_products,write_metaobjects,write_metaobject_definitions,read_themes,write_themes,read_locations,write_inventory,read_publications,write_publications,read_shipping,write_shipping
# The deployed origin, no trailing slash. Must match application_url in shopify.app.toml.
SHOPIFY_APP_URL=https://<your-app>.vercel.app

# ---- Database (Supabase Postgres — session storage) ----
# Percent-encode reserved characters in the password (# -> %23, @ -> %40, / -> %2F).
# Always use the *pooler* host for both: the db.<ref>.supabase.co direct host is
# IPv6-only and Vercel has no IPv6 outbound.
#   Transaction pooler (6543) -> runtime
#   Session pooler     (5432) -> `prisma migrate deploy`
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=shopify
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?schema=shopify

# ---- EcomStrait bridge ----
ECOMSTRAIT_MERCHANT_URL=https://os-merchant.vercel.app
# Must equal SHOPIFY_APP_SHARED_SECRET in the merchant app.
ECOMSTRAIT_SHARED_SECRET=
