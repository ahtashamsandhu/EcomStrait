# ---- Supabase (auth + data) ----
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only key for privileged operations (never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Auth (added in Phase 1) ----
# Google OAuth is configured in the Supabase dashboard; set the redirect URL to
# <this app's origin>/auth/callback. No client secret is needed here.

# ---- Marketing site (Terms of Service / Privacy Policy links) ----
# The public website's canonical origin — onboarding links out to
# <this>/terms and <this>/privacy. Defaults to https://ecomstrait.com.
NEXT_PUBLIC_WEBSITE_URL=https://ecomstrait.com

# ---- AI Gateway (EcomAI supplier assist, via @ecomstrait/ai) ----
# Points at the self-hosted LiteLLM proxy — see Docs/AI-Native-Manual-Setup.md
# and Docs/AI-Native-Migration-Plan.md. Without these, AI features fall back
# to the deterministic preset engine.
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
# Role -> model alias, defined in the proxy's own litellm_config.yaml — never
# a vendor model id here. REQUIRED per role actually used — no hardcoded
# fallback, so a missing role fails loudly instead of silently degrading.
AI_MODEL_WORKHORSE=workhorse
AI_MODEL_REASONING=reasoning
AI_MODEL_FAST_CHEAP=fast-cheap
AI_MODEL_EMBEDDINGS=embeddings

# ---- Resend (best-effort request notifications) ----
RESEND_API_KEY=
RESEND_FROM=EcomStrait <onboarding@resend.dev>

# ---- Stripe (wallet top-ups, Docs/Credits-Settlement-Plan.md — and plan
# subscriptions, mirroring the merchant app's Basic/Premium/Full plans but
# capping catalog size instead of store count) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# This app's own deployed origin, no trailing slash — used for the top-up
# and subscription Checkout sessions' success/cancel URLs.
NEXT_PUBLIC_SUPPLIER_URL=
# Price ids for the paid plans (create these Products/Prices in the Stripe
# Dashboard — separate from the merchant app's own STRIPE_PRICE_* prices).
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_FULL=

# ---- EcomStrait merchant bridge (listing approvals) ----
# When a supplier approves a listing on a Shopify store, this app asks the
# merchant app to push the product — Shopify tokens live there, not here.
# Must match ECOMSTRAIT_INTERNAL_SECRET (or, if that is unset,
# SHOPIFY_APP_SHARED_SECRET) in the merchant app. Requests are signed with it.
ECOMSTRAIT_MERCHANT_URL=https://os-merchant.vercel.app
ECOMSTRAIT_SHARED_SECRET=
