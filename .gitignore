# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root + every workspace)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# turborepo
.turbo/

# testing
coverage/

# next.js (root + every workspace)
.next/
out/

# production
build/

# misc
# OS junk. Also filtered by apps/merchant/scripts/bundle-themes.mjs, which would
# otherwise pack these into the Liquid themes uploaded to merchants' stores.
.DS_Store
Thumbs.db
desktop.ini
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — every real env file stays local; only the placeholder templates are tracked
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/docs
/assets
# Raw store-template library (curated copies live in public/themes)
newstores-themes/

# Raw theme sources. Deliberately at the repo root and outside every app, so no
# Next.js build ever walks them — 191MB of templates has no business being
# traced as part of a bundle. They are uploaded to a private Supabase bucket by
# apps/website/scripts/upload-themes.mjs and served through /api/theme.
/themes/
